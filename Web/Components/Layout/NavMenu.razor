@using Web.Services

<div class="top-row ps-3 navbar navbar-dark">
    <div class="container-fluid">
        <AuthorizeView Policy="@PlayerSessionAuthentication.AuthorizationPolicy">
            <Authorized><a class="navbar-brand" href="/squadra">ArciQuiz Squadra</a></Authorized>
            <NotAuthorized><a class="navbar-brand" href="">ArciQuiz Admin</a></NotAuthorized>
        </AuthorizeView>
    </div>
</div>

<input type="checkbox" title="Navigation menu" class="navbar-toggler" />

<div class="nav-scrollable" onclick="document.querySelector('.navbar-toggler').click()">
    <nav class="nav flex-column">
        <AuthorizeView Policy="@PlayerSessionAuthentication.AuthorizationPolicy">
            <Authorized>
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="/squadra" Match="NavLinkMatch.All">
                        <span class="bi bi-house-door-fill-nav-menu" aria-hidden="true"></span> Partita
                    </NavLink>
                </div>
                <div class="nav-item px-3">
                    <a class="nav-link" href="/squadra/esci">Esci dalla squadra</a>
                </div>
            </Authorized>
            <NotAuthorized>
                <div class="nav-item px-3 text-uppercase text-muted small mt-2">Preparazione</div>
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="" Match="NavLinkMatch.All">
                        <span class="bi bi-house-door-fill-nav-menu" aria-hidden="true"></span> Partite e manche
                    </NavLink>
                </div>
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="/domande" Match="NavLinkMatch.Prefix">
                        <span class="bi bi-list-nested-nav-menu" aria-hidden="true"></span> Catalogo domande
                    </NavLink>
                </div>
                <div class="nav-item px-3 text-uppercase text-muted small mt-2">Conduzione e storico</div>
                <div class="nav-item px-3 text-muted small">Apri regia, lobby e storico dalla partita selezionata.</div>
                <div class="nav-item px-3">
                    <a class="nav-link" href="/logout">Esci dall'area admin</a>
                </div>
            </NotAuthorized>
        </AuthorizeView>
    </nav>
</div>
