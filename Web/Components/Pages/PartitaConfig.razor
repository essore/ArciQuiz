@page "/partita/{Id:int}"
@attribute [Authorize]

@using Core.Entities
@using Core.Enums
@using Core.Services
@using Infrasctructure.Data
@using Microsoft.EntityFrameworkCore
@using Web.Services
@inject IDbContextFactory<ArciQuizDbContext> DbFactory
@inject NavigationManager Nav

<PageTitle>Configura Partita</PageTitle>

@if (_isLoading)
{
    <p>Caricamento...</p>
}
else if (_partita is null)
{
    <div class="alert alert-danger">
        Partita non trovata.
    </div>
}
else
{
    <h1>Configura partita: @_partita.Titolo</h1>
    <p>Completa i passaggi nell'ordine indicato. Puoi tornare ai passaggi precedenti senza perdere le modifiche già salvate.</p>

    <ol>
        <li>Dati della partita</li>
        <li>Manche e regole</li>
        <li>Domande</li>
        <li>Squadre</li>
        <li>Verifica finale e lobby</li>
    </ol>

    <div class="mb-3">
        <button class="btn btn-secondary" @onclick="TornaAllAdmin">
            &larr; Torna al pannello admin
        </button>
    </div>

    <hr />

    <h2>1. Dati della partita</h2>

    <div class="row">
        <div class="col-md-6">
            <div class="mb-3">
                <label class="form-label">Titolo</label>
                <input class="form-control" @bind="_partita.Titolo" disabled="@(!IsPreparazioneModificabile)" />
            </div>

            <button class="btn btn-primary" @onclick="SalvaPartita" disabled="@(!IsPreparazioneModificabile)">
                Salva dettagli partita
            </button>
        </div>

        <div class="col-md-6">
            <div class="card">
                <div class="card-body">
                    <h5 class="card-title">Stato della preparazione</h5>
                    <p class="card-text">
                        @DescriviStatoPreparazione(_partita.Stato)<br />
                        Creata il @_partita.DtCreazione.ToLocalTime().ToString("g")<br />
                        Manches: @_partita.Manches.Count<br />
                        Squadre iscritte: @_partita.PlayersPartita.Count
                    </p>
                </div>
            </div>
        </div>
    </div>

    <hr />

    <h2>2. Manche e regole</h2>

    <div class="mb-3">
        <button class="btn btn-outline-primary" @onclick="AggiungiManche" disabled="@(!IsPreparazioneModificabile)">
            + Aggiungi manche
        </button>
    </div>

    @if (!_partita.Manches.Any())
    {
        <p>Nessuna manche presente.</p>
    }
    else
    {
        <table class="table table-sm align-middle">
            <thead>
                <tr>
                    <th>Tempo risposta (s)</th>
                    <th>Punti base</th>
                    <th>Malus base</th>
                    <th>Moltiplicatore</th>
                    <th>Astensioni gratuite</th>
                    <th>3. Domande</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var m in _partita.Manches.OrderBy(m => m.Id))
                {
                    <tr>
                        <td>
                            <input type="number" class="form-control form-control-sm"
                                   @bind="m.TempoRispostaSecondi" min="5" max="300" disabled="@(!IsPreparazioneModificabile)" />
                        </td>
                        <td>
                            <input type="number" class="form-control form-control-sm"
                                   @bind="m.PuntiBase" min="0" max="100000" disabled="@(!IsPreparazioneModificabile)" />
                        </td>
                        <td>
                            <input type="number" class="form-control form-control-sm"
                                   @bind="m.MalusBase" min="0" max="100000" disabled="@(!IsPreparazioneModificabile)" />
                        </td>
                        <td>
                            <input type="number" class="form-control form-control-sm"
                                   @bind="m.Moltiplicatore" min="1" max="10" disabled="@(!IsPreparazioneModificabile)" />
                        </td>
                        <td>
                            <input type="number" class="form-control form-control-sm"
                                   @bind="m.MaxAstensioni" min="0" max="10" disabled="@(!IsPreparazioneModificabile)" />
                        </td>
                        <td>
                            @m.Domande.Count
                            <button class="btn btn-sm btn-outline-primary ms-2"
                                    @onclick="@(() => VaiConfigDomandeManche(m.Id))" disabled="@(!IsPreparazioneModificabile)">
                                Configura
                            </button>
                        </td>
                        <td>
                            <button class="btn btn-sm btn-danger" @onclick="@(() => RimuoviManche(m))" disabled="@(!IsPreparazioneModificabile)">
                                Elimina
                            </button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>

        <button class="btn btn-primary" @onclick="SalvaManches" disabled="@(!IsPreparazioneModificabile)">
            Salva modifiche manche
        </button>
    }

    <hr />

    <h2>4. Squadre</h2>

    <button class="btn btn-outline-primary mb-3" @onclick="VaiGestioneSquadre">
        Gestisci squadre
    </button>

    @if (!_players.Any())
    {
        <p>Nessuna squadra iscritta (per ora).</p>
    }
    else
    {
        <table class="table table-sm">
            <thead>
                <tr>
                    <th>Nome squadra</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var p in _players)
                {
                    <tr>
                        <td>@p.NomeSquadra</td>
                    </tr>
                }
            </tbody>
        </table>
    }

    <hr />

    <h2>5. Verifica finale e lobby</h2>
    <p>La lobby si apre soltanto dopo il controllo dei requisiti. Gli stati di svolgimento restano gestiti dalla regia.</p>

    @if (_requisitiMancanti.Any())
    {
        <div class="alert alert-warning">
            <strong>Completa questi requisiti prima di aprire la lobby:</strong>
            <ul class="mb-0 mt-2">
                @foreach (var requisito in _requisitiMancanti)
                {
                    <li>@requisito</li>
                }
            </ul>
        </div>
    }
    else
    {
        <div class="alert alert-success">
            <strong>Checklist completata.</strong> La partita contiene dati, manche e domande validi.
        </div>
    }

    @if (_partita.Stato == PartitaStato.Pronta)
    {
        <div class="alert alert-info">La lobby è pronta per le iscrizioni pubbliche.</div>
        <button class="btn btn-outline-secondary" @onclick="TornaInPreparazioneAsync">
            Torna alla preparazione
        </button>
    }
    else if (_partita.Stato is PartitaStato.Nuova or PartitaStato.Configurazione)
    {
        <button class="btn btn-success" @onclick="DichiaraProntaAsync" disabled="@_requisitiMancanti.Any()">
            Apri la lobby e dichiara la partita pronta
        </button>
    }

    @if (!string.IsNullOrEmpty(_messaggio))
    {
        <div class="alert alert-success mt-3">@_messaggio</div>
    }

    @if (!string.IsNullOrEmpty(_errore))
    {
        <div class="alert alert-danger mt-3">@_errore</div>
    }
}

@code {
    [Parameter] public int Id { get; set; }

    private Partita? _partita;
    private List<Player> _players = new();
    private bool _isLoading = true;
    private string? _messaggio;
    private string? _errore;
    private IReadOnlyList<string> _requisitiMancanti = [];

    protected override async Task OnParametersSetAsync()
    {
        _isLoading = true;
        _messaggio = null;
        _errore = null;

        await using var db = await DbFactory.CreateDbContextAsync();

        _partita = await db.Partite
            .AsNoTracking()
            .Include(p => p.Manches)
                .ThenInclude(m => m.Domande)
            .Include(p => p.PlayersPartita)
                .ThenInclude(pp => pp.Player)
            .FirstOrDefaultAsync(p => p.Id == Id);

        _players = _partita?.PlayersPartita
            .Select(pp => pp.Player!)
            .Distinct()
            .ToList() ?? new List<Player>();

        AggiornaChecklist();

        _isLoading = false;
    }

    private async Task SalvaPartita()
    {
        if (_partita is null) return;

        _messaggio = null;
        _errore = null;

        if (string.IsNullOrWhiteSpace(_partita.Titolo))
        {
            _errore = "Il titolo della partita è obbligatorio.";
            return;
        }

        try
        {
            await using var db = await DbFactory.CreateDbContextAsync();
            var partita = await db.Partite
                .Include(item => item.Manches)
                    .ThenInclude(manche => manche.Domande)
                        .ThenInclude(mancheDomanda => mancheDomanda.Domanda)
                .FirstOrDefaultAsync(item => item.Id == _partita.Id);
            if (partita is null)
            {
                _errore = "La partita non è più disponibile.";
                return;
            }

            if (partita.Stato is not (PartitaStato.Nuova or PartitaStato.Configurazione))
            {
                _errore = "Per modificare i dettagli, riporta prima la partita in preparazione.";
                return;
            }

            partita.Titolo = _partita.Titolo.Trim();
            _partita.Titolo = partita.Titolo;
            await db.SaveChangesAsync();
            _messaggio = "Dettagli partita salvati.";
            AggiornaChecklist();
        }
        catch (Exception ex)
        {
            _errore = "Errore nel salvataggio della partita: " + ex.Message;
        }
    }

    private async Task SalvaManches()
    {
        if (_partita is null) return;

        try
        {
            _messaggio = null;
            _errore = null;

            var errori = _partita.Manches
                .SelectMany(manche => MancheRulesValidator.Validate(manche).Errori)
                .Distinct()
                .ToList();
            if (errori.Count > 0)
            {
                _errore = string.Join(" ", errori);
                return;
            }

            await using var db = await DbFactory.CreateDbContextAsync();
            var partitaStato = await db.Partite
                .Where(item => item.Id == _partita.Id)
                .Select(item => item.Stato)
                .FirstOrDefaultAsync();
            if (partitaStato is not (PartitaStato.Nuova or PartitaStato.Configurazione))
            {
                _errore = "Per modificare le manche, riporta prima la partita in preparazione.";
                return;
            }

            if (_partita.Manches.Any(item => item.Stato is MancheStato.InGioco or MancheStato.Conclusa))
            {
                _errore = "Avviare e concludere le manche dalla regia.";
                return;
            }

            foreach (var mancheModificata in _partita.Manches)
            {
                var manche = await db.Manches.FirstOrDefaultAsync(item => item.Id == mancheModificata.Id);
                if (manche is null)
                    continue;

                manche.TempoRispostaSecondi = mancheModificata.TempoRispostaSecondi;
                manche.PuntiBase = mancheModificata.PuntiBase;
                manche.MalusBase = mancheModificata.MalusBase;
                manche.Moltiplicatore = mancheModificata.Moltiplicatore;
                manche.MaxAstensioni = mancheModificata.MaxAstensioni;
            }

            await db.SaveChangesAsync();
            _messaggio = "Modifiche alle manches salvate.";
            AggiornaChecklist();
        }
        catch (Exception ex)
        {
            _errore = "Errore nel salvataggio delle manches: " + ex.Message;
        }
    }

    private async Task AggiungiManche()
    {
        if (_partita is null) return;

        await using var db = await DbFactory.CreateDbContextAsync();
        if (!await PuoModificarePreparazioneAsync(db))
            return;

        var ordineSuccessivo = (await db.Manches
            .Where(item => item.PartitaId == _partita.Id)
            .Select(item => (int?)item.Ordine)
            .MaxAsync() ?? 0) + 1;

        var nuova = new Manche
        {
            PartitaId = _partita.Id,
            Ordine = ordineSuccessivo,
            TempoRispostaSecondi = 20,
            PuntiBase = 2000,
            MalusBase = 500,
            Moltiplicatore = 1,
            PenalitaErrore = true,
            MaxAstensioni = 3
        };

        db.Manches.Add(nuova);
        await db.SaveChangesAsync();

        await OnParametersSetAsync();
        StateHasChanged();
    }

    private async Task RimuoviManche(Manche manche)
    {
        if (_partita is null) return;

        await using var db = await DbFactory.CreateDbContextAsync();
        if (!await PuoModificarePreparazioneAsync(db))
            return;

        var mancheDaRimuovere = await db.Manches.FirstOrDefaultAsync(item => item.Id == manche.Id);
        if (mancheDaRimuovere is null)
            return;

        db.Manches.Remove(mancheDaRimuovere);
        await db.SaveChangesAsync();

        await OnParametersSetAsync();
        StateHasChanged();
    }
    private void VaiConfigDomandeManche(int mancheId)
    {
        Nav.NavigateTo($"/manche/{mancheId}/domande");
    }

    private void TornaAllAdmin()
    {
        Nav.NavigateTo("/admin");
    }

    private void VaiGestioneSquadre()
    {
        Nav.NavigateTo($"/partita/{Id}/squadre");
    }

    private bool IsPreparazioneModificabile => _partita?.Stato is PartitaStato.Nuova or PartitaStato.Configurazione;

    private async Task<bool> PuoModificarePreparazioneAsync(ArciQuizDbContext db)
    {
        var stato = await db.Partite
            .Where(item => item.Id == Id)
            .Select(item => (PartitaStato?)item.Stato)
            .FirstOrDefaultAsync();
        if (stato is PartitaStato.Nuova or PartitaStato.Configurazione)
            return true;

        _errore = "Per modificare la preparazione, riporta prima la partita in preparazione.";
        return false;
    }

    private async Task DichiaraProntaAsync()
    {
        _messaggio = null;
        _errore = null;

        await using var db = await DbFactory.CreateDbContextAsync();
        var result = await PartitaPreparazioneService.DichiaraProntaAsync(db, Id);
        if (!result.IsSuccess)
        {
            _requisitiMancanti = result.RequisitiMancanti;
            _errore = result.RequisitiMancanti.Any()
                ? string.Join(" ", result.RequisitiMancanti)
                : result.Messaggio;
            return;
        }

        _partita!.Stato = PartitaStato.Pronta;
        _partita.Fase = GamePhase.Lobby;
        _messaggio = result.Messaggio;
        AggiornaChecklist();
    }

    private async Task TornaInPreparazioneAsync()
    {
        _messaggio = null;
        _errore = null;

        await using var db = await DbFactory.CreateDbContextAsync();
        var result = await PartitaPreparazioneService.TornaInPreparazioneAsync(db, Id);
        if (!result.IsSuccess)
        {
            _errore = result.Messaggio;
            return;
        }

        _partita!.Stato = PartitaStato.Configurazione;
        _partita.Fase = GamePhase.Idle;
        _messaggio = result.Messaggio;
        AggiornaChecklist();
    }

    private void AggiornaChecklist()
    {
        _requisitiMancanti = _partita is null
            ? []
            : PartitaProntaValidator.Validate(_partita).Errori;
    }

    private static string DescriviStatoPreparazione(PartitaStato stato) => stato switch
    {
        PartitaStato.Nuova or PartitaStato.Configurazione => "In preparazione",
        PartitaStato.Pronta => "Lobby pronta",
        PartitaStato.InCorso => "In conduzione",
        PartitaStato.Conclusa => "Nello storico",
        _ => "Stato non disponibile"
    };

}
