@page "/"
@attribute [Authorize]
@page "/admin"
@rendermode InteractiveServer

@using Infrasctructure.Data
@using Core.Entities
@using Core.Enums
@using Microsoft.EntityFrameworkCore
@inject IDbContextFactory<ArciQuizDbContext> DbFactory

<PageTitle>ArciQuiz - Admin</PageTitle>

<h1>ArciQuiz – Pannello Admin</h1>
<p>Configura e gestisci le partite del quiz.</p>

<hr />

<h2>Partita attiva</h2>

@if (_partitaAttiva is null)
{
    <div class="alert alert-info">
        Nessuna partita attiva al momento.
    </div>

    <button class="btn btn-primary" @onclick="NuovaPartitaMock">
        Crea nuova partita di prova
    </button>
}
else
{
    <div class="card mb-3">
        <div class="card-body">
            <h3 class="card-title">@_partitaAttiva.Titolo</h3>
            <p class="card-text">
                Stato: <strong>@_partitaAttiva.Stato</strong><br />
                Creata il @_partitaAttiva.DtCreazione.ToLocalTime().ToString("g")<br />
                Manches: @_partitaAttiva.Manches.Count<br />
                Squadre iscritte: @_partitaAttiva.PlayersPartita.Count
            </p>
            <button class="btn btn-primary me-2" @onclick="@(() => VaiAConfigPartita(_partitaAttiva!.Id))">
                Configura partita
            </button>

            <button class="btn btn-success me-2" @onclick="@(() => VaiARegia(_partitaAttiva!.Id))">
                Apri regia partita
            </button>
            <button class="btn btn-secondary" disabled>
                Apri vista proiettore (coming soon)
            </button>

            @if (_partitaAttiva.Stato == PartitaStato.Pronta)
            {
                <LanQr Title="QR iscrizione squadre"
                       RelativePath="/registrazione"
                       Port="5000"
                       MaxWidthPx="240" />
            }
        </div>
    </div>
}

<hr />

<h2>Azioni rapide</h2>

<div class="mb-3">
    <button class="btn btn-outline-primary me-2" @onclick="VaiNuovaPartita">
        Nuova partita!
    </button>
    <button class="btn btn-outline-secondary me-2" disabled>
        Gestisci domande
    </button>
    <button class="btn btn-outline-secondary" @onclick="VaiAllePartiteDemo">
        Elenco partite (demo)
    </button>
</div>

<hr />

<h2>Ultime partite</h2>

@if (_ultimePartite is null)
{
    <p>Caricamento...</p>
}
else if (!_ultimePartite.Any())
{
    <p>Nessuna partita presente nel database.</p>
}
else
{
    <table class="table">
        <thead>
            <tr>
                <th>Titolo</th>
                <th>Stato</th>
                <th>Creata il</th>
                <th>Manches</th>
                <th>Squadre</th>
                <th>Azioni</th>

            </tr>
        </thead>
        <tbody>
            @foreach (var p in _ultimePartite)
            {
                <tr>
                    <td>@p.Titolo</td>
                    <td>@p.Stato</td>
                    <td>@p.DtCreazione.ToLocalTime().ToString("g")</td>
                    <td>@p.Manches.Count</td>
                    <td>@p.PlayersPartita.Count</td>
                    <td>
                        <button class="btn btn-sm btn-outline-primary"
                                @onclick="@(() => VaiAConfigPartita(p.Id))">
                            Configura
                        </button>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

@code {
    private Partita? _partitaAttiva;
    private List<Partita>? _ultimePartite;
    [Inject] NavigationManager Nav { get; set; } = default!;


    protected override async Task OnInitializedAsync()
    {
        await using var db = await DbFactory.CreateDbContextAsync();

        // per ora consideriamo attiva "l'ultima non conclusa"
        _partitaAttiva = await db.Partite
            .AsNoTracking()
            .Include(p => p.Manches)
            .Include(p => p.PlayersPartita)
            .Where(p => p.Stato != PartitaStato.Conclusa)
            .OrderByDescending(p => p.DtCreazione)
            .FirstOrDefaultAsync();

        _ultimePartite = await db.Partite
            .AsNoTracking()
            .Include(p => p.Manches)
            .Include(p => p.PlayersPartita)
            .OrderByDescending(p => p.DtCreazione)
            .Take(10)
            .ToListAsync();
    }
    private void VaiAConfigPartita(int partitaId)
    {
        Nav.NavigateTo($"/partita/{partitaId}");
    }
    // per ora: crea una partita di prova veloce
    private async Task NuovaPartitaMock()
    {
        var p = new Partita
        {
            Titolo = "Nuova partita demo " + DateTime.Now.ToString("HH:mm")
        };

        await using var db = await DbFactory.CreateDbContextAsync();
        db.Partite.Add(p);
        await db.SaveChangesAsync();

        // ricarica dati
        await OnInitializedAsync();
        StateHasChanged();
    }

    private void VaiAllePartiteDemo()
    {
        // in un secondo momento useremo NavigationManager
        // per ora puoi semplicemente andare manualmente a /partite-demo
    }
    private void VaiARegia(int partitaId)
    {
        Nav.NavigateTo($"/regia/{partitaId}");
    }
    private void VaiNuovaPartita()
    {
        Nav.NavigateTo("/nuova-partita");
    }
}
