@page "/"
@attribute [Authorize]
@page "/admin"
@rendermode InteractiveServer

@using Infrasctructure.Data
@using Core.Entities
@using Core.Enums
@using Microsoft.EntityFrameworkCore
@using Web.Services
@inject IDbContextFactory<ArciQuizDbContext> DbFactory
@inject NavigationManager Nav

<PageTitle>ArciQuiz - Admin</PageTitle>

<h1>ArciQuiz – Pannello Admin</h1>
<p>Configura e gestisci le partite del quiz.</p>

<hr />

<h2>Partita attiva</h2>

@if (_partitaAttiva is null)
{
    <div class="alert alert-info">
        Nessuna partita attiva al momento.
    </div>

}
else
{
    <div class="card mb-3">
        <div class="card-body">
            <h3 class="card-title">@_partitaAttiva.Titolo</h3>
            <p class="card-text">
                Stato: <strong>@_partitaAttiva.Stato</strong><br />
                Creata il @_partitaAttiva.DtCreazione.ToLocalTime().ToString("g")<br />
                Manches: @_partitaAttiva.Manches.Count<br />
                Squadre iscritte: @_partitaAttiva.PlayersPartita.Count
            </p>
            <button class="btn btn-primary me-2" @onclick="@(() => VaiAConfigPartita(_partitaAttiva!.Id))">
                Configura partita
            </button>

            <button class="btn btn-success me-2" @onclick="@(() => VaiARegia(_partitaAttiva!.Id))">
                Apri regia partita
            </button>
            <a class="btn btn-secondary" href="@($"/proiettore/{_partitaAttiva.Id}")" target="_blank">
                Apri vista proiettore
            </a>

            @if (_partitaAttiva.Stato == PartitaStato.Pronta)
            {
                <a class="btn btn-outline-primary mt-3" href="@($"/lobby/{_partitaAttiva.Id}")" target="_blank">
                    Apri lobby sul proiettore
                </a>
            }
        </div>
    </div>
}

<hr />

@if (!string.IsNullOrWhiteSpace(_messaggio))
{
    <div class="alert alert-success">@_messaggio</div>
}
@if (!string.IsNullOrWhiteSpace(_errore))
{
    <div class="alert alert-danger">@_errore</div>
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2 class="mb-0">Partite</h2>
    <button class="btn btn-primary" @onclick="VaiNuovaPartita">
        Nuova partita
    </button>
</div>

@if (_ultimePartite is null)
{
    <p>Caricamento...</p>
}
else if (!_ultimePartite.Any())
{
    <p>Nessuna partita presente nel database.</p>
}
else
{
    <div class="table-responsive">
    <table class="table">
        <thead>
            <tr>
                <th>Titolo</th>
                <th>Stato</th>
                <th>Creata il</th>
                <th>Manches</th>
                <th>Squadre</th>
                <th>Azioni</th>

            </tr>
        </thead>
        <tbody>
            @foreach (var p in _ultimePartite)
            {
                <tr>
                    <td>@p.Titolo</td>
                    <td>@p.Stato</td>
                    <td>@p.DtCreazione.ToLocalTime().ToString("g")</td>
                    <td>@p.Manches.Count</td>
                    <td>@p.PlayersPartita.Count</td>
                    <td>
                        <button class="btn btn-sm btn-outline-primary"
                                @onclick="@(() => VaiAConfigPartita(p.Id))">
                            Configura
                        </button>
                        <button class="btn btn-sm btn-outline-success ms-1"
                                @onclick="@(() => VaiARegia(p.Id))">
                            Regia
                        </button>
                        <a class="btn btn-sm btn-outline-secondary ms-1" href="@($"/proiettore/{p.Id}")" target="_blank">
                            Proiettore
                        </a>
                        <button class="btn btn-sm btn-outline-primary ms-1"
                                @onclick="@(() => VaiAClonaPartita(p.Id))">
                            Clona
                        </button>
                        @if (!p.IsAttiva && p.Stato != PartitaStato.Conclusa)
                        {
                            <button class="btn btn-sm btn-primary ms-1"
                                    @onclick="@(() => ImpostaPartitaAttivaAsync(p.Id))">
                                Rendi attiva
                            </button>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
    </div>
}

@code {
    private Partita? _partitaAttiva;
    private List<Partita>? _ultimePartite;
    private string? _messaggio;
    private string? _errore;

    protected override async Task OnInitializedAsync()
    {
        await CaricaAsync();
    }

    private async Task CaricaAsync()
    {
        await using var db = await DbFactory.CreateDbContextAsync();

        _partitaAttiva = await db.Partite
            .AsNoTracking()
            .Include(p => p.Manches)
            .Include(p => p.PlayersPartita)
            .Where(p => p.IsAttiva)
            .FirstOrDefaultAsync();

        _ultimePartite = await db.Partite
            .AsNoTracking()
            .Include(p => p.Manches)
            .Include(p => p.PlayersPartita)
            .OrderByDescending(p => p.DtCreazione)
            .Take(10)
            .ToListAsync();
    }
    private void VaiAConfigPartita(int partitaId)
    {
        Nav.NavigateTo($"/partita/{partitaId}");
    }
    private async Task ImpostaPartitaAttivaAsync(int partitaId)
    {
        _messaggio = null;
        _errore = null;
        await using var db = await DbFactory.CreateDbContextAsync();
        var result = await PartitaAttivaService.ImpostaAttivaAsync(db, partitaId);
        if (result.IsSuccess)
            _messaggio = result.Messaggio;
        else
            _errore = result.Messaggio;

        await CaricaAsync();
    }

    private void VaiARegia(int partitaId)
    {
        Nav.NavigateTo($"/regia/{partitaId}");
    }
    private void VaiAClonaPartita(int partitaId)
    {
        Nav.NavigateTo($"/partita/{partitaId}/clona");
    }
    private void VaiNuovaPartita()
    {
        Nav.NavigateTo("/nuova-partita");
    }
}
