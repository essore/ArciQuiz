@page "/regia/{PartitaId:int}"

@using Core.Entities
@using Core.Enums
@using Infrasctructure.Data
@using Microsoft.EntityFrameworkCore
@inject ArciQuizDbContext Db
@inject NavigationManager Nav

<PageTitle>Regia partita</PageTitle>

@if (_isLoading)
{
    <p>Caricamento...</p>
}
else if (_partita is null)
{
    <div class="alert alert-danger">
        Partita non trovata.
    </div>
}
else
{
    <h1>Regia – @_partita.Titolo</h1>

    <div class="mb-3">
        <button class="btn btn-secondary" @onclick="TornaAllAdmin">
            &larr; Torna al pannello admin
        </button>
    </div>

    <div class="row">
        <div class="col-md-4">
            <h2>Info partita</h2>
            <p>
                Id: @_partita.Id<br />
                Stato: @_partita.Stato<br />
                Creata il @_partita.DtCreazione.ToLocalTime().ToString("g")<br />
                Manches: @_partita.Manches.Count
            </p>

            <div class="mb-3">
                <label class="form-label">Manche</label>
                <select class="form-select" @bind="mancheSelezionataId">
                    <option value="">-- Seleziona manche --</option>
                    @foreach (var m in _partita.Manches.OrderBy(m => m.Id))
                    {
                        <option value="@m.Id">
                            Manche @m.Id (@m.Stato) - Domande: @m.Domande.Count
                        </option>
                    }
                </select>
            </div>

            @if (_mancheCorrente is not null)
            {
                <div class="card">
                    <div class="card-body">
                        <h5 class="card-title">Stato manche @(_mancheCorrente.Id)</h5>
                        <p class="card-text">
                            Stato: <strong>@_mancheCorrente.Stato</strong><br />
                            Domande totali: @_mancheCorrente.Domande.Count<br />
                            Domanda corrente: @(_domandaCorrente is null ? "—" : _domandaCorrente.Index.ToString())
                        </p>

                        <div class="d-grid gap-2">
                            <button class="btn btn-primary"
                                    @onclick="StartManche"
                                    disabled="@(!_puoStartare)">
                                Avvia manche / prima domanda
                            </button>

                            <button class="btn btn-success"
                                    @onclick="ProssimaDomanda"
                                    disabled="@(!_puoPassareProssima)">
                                Prossima domanda
                            </button>

                            <button class="btn btn-warning"
                                    @onclick="ChiudiManche"
                                    disabled="@(_mancheCorrente.Stato == MancheStato.Conclusa)">
                                Chiudi manche
                            </button>
                            <button class="btn btn-dark" @onclick="ApriProiettore">
                                Apri proiettore
                            </button>
                        </div>
                    </div>
                </div>
            }
            else
            {
                <p>Seleziona una manche per iniziare la regia.</p>
            }

            @if (!string.IsNullOrEmpty(_messaggio))
            {
                <div class="alert alert-success mt-3">@_messaggio</div>
            }
            @if (!string.IsNullOrEmpty(_errore))
            {
                <div class="alert alert-danger mt-3">@_errore</div>
            }
        </div>

        <div class="col-md-8">
            <h2>Domande della manche</h2>

            @if (_mancheCorrente is null)
            {
                <p>Seleziona una manche per vedere le domande.</p>
            }
            else if (!_mancheCorrente.Domande.Any())
            {
                <p>Nessuna domanda associata a questa manche.</p>
            }
            else
            {
                <table class="table table-sm align-middle">
                    <thead>
                        <tr>
                            <th>#</th>
                            <th>Stato</th>
                            <th>Domanda</th>
                            <th>Categoria</th>
                            <th>Difficoltà</th>
                        </tr>
                    </thead>
                    <tbody>
                    @foreach (var md in _mancheCorrente.Domande.OrderBy(md => md.Index))
                    {
                        var isCorrente = _domandaCorrente is not null && md.Id == _domandaCorrente.Id;
                        <tr class="@(isCorrente ? "table-info" : string.Empty)">
                            <td>@md.Index</td>
                            <td>
                                @{
                                    var statoDomanda = GetStatoDomanda(md);
                                }
                                @statoDomanda
                            </td>
                            <td>
                                <strong>@md.Domanda?.Testo</strong><br />
                                A: @md.Domanda?.RispostaA<br />
                                B: @md.Domanda?.RispostaB<br />
                                C: @md.Domanda?.RispostaC<br />
                                D: @md.Domanda?.RispostaD
                            </td>
                            <td>@md.Domanda?.Categoria</td>
                            <td>@md.Domanda?.Difficolta</td>
                        </tr>
                    }
                    </tbody>
                </table>
            }

            @if (_domandaCorrente is not null)
            {
                <hr />
                <h2>Domanda corrente</h2>
                <div class="card">
                    <div class="card-body">
                        <h4>@_domandaCorrente.Domanda?.Testo</h4>
                        <p>
                            A) @_domandaCorrente.Domanda?.RispostaA<br />
                            B) @_domandaCorrente.Domanda?.RispostaB<br />
                            C) @_domandaCorrente.Domanda?.RispostaC<br />
                            D) @_domandaCorrente.Domanda?.RispostaD
                        </p>
                        <p class="text-muted">
                            (Per ora risposta corretta solo visibile qui: @_domandaCorrente.Domanda?.RispostaEsatta)
                        </p>
                    </div>
                </div>
            }
        </div>
    </div>
}

@code {
    [Parameter] public int PartitaId { get; set; }

    private Partita? _partita;
    private Manche? _mancheCorrente;
    private MancheDomanda? _domandaCorrente;

    private bool _isLoading = true;
    private string? _mancheSelezionataId;
    private string? _messaggio;
    private string? _errore;

    private string mancheSelezionataId
    {
        get => _mancheSelezionataId;
        set
        {
            _mancheSelezionataId = value;
            OnMancheChangedHandler(_mancheSelezionataId);
        }
    }


    private bool _puoStartare => _mancheCorrente is not null
                                 && _mancheCorrente.Stato != MancheStato.InGioco
                                 && _mancheCorrente.Domande.Any();

    private bool _puoPassareProssima => _mancheCorrente is not null
                                        && _mancheCorrente.Stato == MancheStato.InGioco
                                        && _mancheCorrente.Domande.Any();

    protected override async Task OnParametersSetAsync()
    {
        _isLoading = true;
        _messaggio = null;
        _errore = null;

        _partita = await Db.Partite
            .Include(p => p.Manches)
                .ThenInclude(m => m.Domande)
                    .ThenInclude(md => md.Domanda)
            .FirstOrDefaultAsync(p => p.Id == PartitaId);

        if (_partita != null)
        {
            // se non c'è manche selezionata, prendi la prima
            var firstManche = _partita.Manches.OrderBy(m => m.Id).FirstOrDefault();
            if (firstManche != null)
            {
                _mancheCorrente = firstManche;
                _mancheSelezionataId = firstManche.Id.ToString();
                AggiornaDomandaCorrente();
            }
        }

        _isLoading = false;
    }

    private async Task OnMancheChangedHandler(string val)
    {
        _mancheSelezionataId = val;
        if (int.TryParse(_mancheSelezionataId, out var mid) && _partita is not null)
        {
            _mancheCorrente = _partita.Manches.FirstOrDefault(m => m.Id == mid);
            AggiornaDomandaCorrente();
        }
        await InvokeAsync(StateHasChanged);
    }

    private void AggiornaDomandaCorrente()
    {
        _domandaCorrente = null;

        if (_mancheCorrente is null)
            return;

        _domandaCorrente = _mancheCorrente.Domande
            .OrderBy(md => md.Index)
            .FirstOrDefault(md => md.DtStart != null && md.DtEnd == null);
    }

    private async Task StartManche()
    {
        if (_mancheCorrente is null) return;
        if (!_mancheCorrente.Domande.Any()) return;

        try
        {
            // se non c'è ancora una domanda corrente, avvia la prima
            var ordered = _mancheCorrente.Domande.OrderBy(md => md.Index).ToList();
            var current = ordered.FirstOrDefault(md => md.DtStart != null && md.DtEnd == null);

            if (current == null)
            {
                var first = ordered.First();
                first.DtStart = DateTime.UtcNow;

                _mancheCorrente.Stato = MancheStato.InGioco;

                await Db.SaveChangesAsync();
                AggiornaDomandaCorrente();
                _messaggio = "Manche avviata e prima domanda attiva.";
            }
            else
            {
                _messaggio = "La manche è già in corso.";
            }
        }
        catch (Exception ex)
        {
            _errore = "Errore nell'avviare la manche: " + ex.Message;
        }
    }

    private async Task ProssimaDomanda()
    {
        if (_mancheCorrente is null) return;
        if (!_mancheCorrente.Domande.Any()) return;

        try
        {
            var ordered = _mancheCorrente.Domande.OrderBy(md => md.Index).ToList();

            var current = ordered.FirstOrDefault(md => md.DtStart != null && md.DtEnd == null);

            if (current == null)
            {
                // se nessuna domanda è ancora attiva, avvia la prima
                var first = ordered.First();
                first.DtStart = DateTime.UtcNow;
                _mancheCorrente.Stato = MancheStato.InGioco;
                await Db.SaveChangesAsync();
                AggiornaDomandaCorrente();
                _messaggio = "Prima domanda attivata.";
                return;
            }

            // chiudi quella corrente
            current.DtEnd = DateTime.UtcNow;

            // trova la successiva
            var next = ordered.FirstOrDefault(md => md.Index > current.Index);

            if (next != null)
            {
                next.DtStart = DateTime.UtcNow;
                await Db.SaveChangesAsync();
                AggiornaDomandaCorrente();
                _messaggio = $"Passato alla domanda {next.Index}.";
            }
            else
            {
                // nessuna successiva: chiudi la manche
                _mancheCorrente.Stato = MancheStato.Conclusa;
                await Db.SaveChangesAsync();
                AggiornaDomandaCorrente();
                _messaggio = "Nessuna domanda successiva. Manche conclusa.";
            }
        }
        catch (Exception ex)
        {
            _errore = "Errore nel passare alla prossima domanda: " + ex.Message;
        }
    }

    private async Task ChiudiManche()
    {
        if (_mancheCorrente is null) return;

        try
        {
            // chiudi eventuale domanda corrente
            var current = _mancheCorrente.Domande
                .FirstOrDefault(md => md.DtStart != null && md.DtEnd == null);

            if (current != null)
            {
                current.DtEnd = DateTime.UtcNow;
            }

            _mancheCorrente.Stato = MancheStato.Conclusa;

            await Db.SaveChangesAsync();
            AggiornaDomandaCorrente();
            _messaggio = "Manche chiusa manualmente.";
        }
        catch (Exception ex)
        {
            _errore = "Errore nel chiudere la manche: " + ex.Message;
        }
    }

    private string GetStatoDomanda(MancheDomanda md)
    {
        if (md.DtStart == null && md.DtEnd == null)
            return "In attesa";
        if (md.DtStart != null && md.DtEnd == null)
            return "In corso";
        if (md.DtStart != null && md.DtEnd != null)
            return "Conclusa";

        return "Sconosciuto";
    }

    private void TornaAllAdmin()
    {
        Nav.NavigateTo("/admin");
    }
    private void ApriProiettore()
    {
        Nav.NavigateTo($"/proiettore/{PartitaId}");
    }
}
