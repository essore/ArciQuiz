@page "/regia/{PartitaId:int}"
@attribute [Authorize]
@implements IDisposable

@using Core.Entities
@using Core.Enums
@using Core.Services
@using Infrasctructure.Data
@using Microsoft.EntityFrameworkCore
@using Web.Services
@inject IDbContextFactory<ArciQuizDbContext> DbFactory
@inject NavigationManager Nav
@inject IGameStateService GameState
@inject TimeProvider Clock

<PageTitle>Regia partita</PageTitle>

@if (_isLoading)
{
    <p>Caricamento...</p>
}
else if (_partita is null)
{
    <div class="alert alert-danger">Partita non trovata.</div>
}
else if (_richiedeConfermaAttivazione)
{
    <h1>Apri regia: @_partita.Titolo</h1>
    <div class="alert alert-warning" role="alert">
        <p class="mb-3">La partita attiva attuale è <strong>@_partitaAttivaDaSostituire</strong>. Vuoi sostituirla con <strong>@_partita.Titolo</strong>?</p>
        <button class="btn btn-primary me-2" @onclick="ConfermaAttivazioneAsync" aria-label="Conferma il cambio della partita attiva">
            <span aria-hidden="true">▶</span> Conferma e apri regia
        </button>
        <button class="btn btn-outline-secondary" @onclick="TornaAllAdmin" aria-label="Annulla il cambio della partita attiva">
            Annulla
        </button>
    </div>
}
else
{
    <div class="d-flex justify-content-between align-items-center gap-3 mb-3">
        <h1 class="mb-0">Regia della partita: @_partita.Titolo</h1>
        <a class="btn btn-dark flex-shrink-0" href="@($"/proiettore/{PartitaId}")" target="_blank" aria-label="Apri il proiettore della partita">
            <span aria-hidden="true">▣</span> Apri proiettore
        </a>
    </div>

    <div class="mb-3">
        <button class="btn btn-outline-secondary" @onclick="TornaAllAdmin" aria-label="Torna al pannello amministrativo">
            <span aria-hidden="true">←</span> Torna al pannello admin
        </button>
    </div>

    <section class="card border-primary shadow-sm sticky-top mb-3" style="top: .5rem; z-index: 1020;">
        <div class="card-body">
            <div class="d-flex flex-wrap justify-content-between align-items-center gap-3">
                <div>
                    <h2 class="h4 mb-1">@DescriviFase(_partita.Fase)</h2>
                    <p class="mb-0">Stato partita: <strong>@DescriviStato(_partita.Stato)</strong></p>
                    @if (_partita.Fase == GamePhase.ShowingQuestion && _domandaCorrente?.ScadenzaUtc is not null)
                    {
                        <p class="mb-0 mt-1">Tempo rimasto: <ServerCountdown EndsAtUtc="_domandaCorrente.ScadenzaUtc.Value" /></p>
                    }
                </div>
                <div class="d-flex flex-wrap gap-2">
                    @if (_partita.Fase == GamePhase.Lobby)
                    {
                        <button class="btn btn-primary" @onclick="AvviaPartitaAsync" aria-label="Avvia partita">
                            <span aria-hidden="true">▶</span> Avvia partita
                        </button>
                    }
                    else if (_partita.Fase == GamePhase.ShowingQuestion && _domandaCorrente is not null)
                    {
                        <button class="btn btn-primary" @onclick="ChiudiDomandaAsync" aria-label="Chiudi domanda e mostra soluzione">
                            <span aria-hidden="true">■</span> Chiudi domanda e mostra soluzione
                        </button>
                    }
                    else if (_partita.Fase == GamePhase.ShowingAnswers && _domandaCorrente is not null)
                    {
                        <button class="btn btn-primary" @onclick="MostraClassificaAsync" aria-label="Mostra classifica">
                            <span aria-hidden="true">▤</span> Mostra classifica
                        </button>
                        @if (_haDomandaSuccessiva)
                        {
                            <button class="btn btn-outline-primary" @onclick="ProssimaDomandaAsync" aria-label="Apri domanda successiva">
                                <span aria-hidden="true">▶</span> Prossima domanda
                            </button>
                        }
                    }
                    else if (_partita.Fase == GamePhase.Leaderboard && _domandaCorrente is not null)
                    {
                        @if (_haDomandaSuccessiva)
                        {
                            <button class="btn btn-primary" @onclick="ProssimaDomandaAsync" aria-label="Apri domanda successiva">
                                <span aria-hidden="true">▶</span> Prossima domanda
                            </button>
                        }
                        else
                        {
                            <button class="btn btn-primary" @onclick="ChiudiMancheAsync" aria-label="Concludi manche">
                                <span aria-hidden="true">■</span> Concludi manche
                            </button>
                        }
                    }
                    else if (_partita.Fase == GamePhase.RoundEnded)
                    {
                        @if (_haMancheSuccessiva)
                        {
                            <button class="btn btn-primary" @onclick="AvviaMancheSuccessivaAsync" aria-label="Avvia manche successiva">
                                <span aria-hidden="true">▶</span> Avvia manche successiva
                            </button>
                        }
                        else
                        {
                            <button class="btn btn-primary" @onclick="ConcludiPartitaAsync" aria-label="Concludi partita">
                                <span aria-hidden="true">■</span> Concludi partita
                            </button>
                        }
                    }
                    <button class="btn btn-outline-secondary" @onclick="CambiaVisibilitaQrAsync" aria-label="@(_qrVisibile ? "Nascondi QR sul proiettore" : "Mostra QR sul proiettore")">
                        <span aria-hidden="true">▣</span> @(_qrVisibile ? "Nascondi QR" : "Mostra QR")
                    </button>
                </div>
            </div>
        </div>
    </section>

    <section class="card mb-3">
        <div class="card-body">
            <h2 class="h4">Contesto corrente</h2>
            @if (_mancheCorrente is null)
            {
                <p class="mb-0">Nessuna manche disponibile per questa partita.</p>
            }
            else
            {
                <p>Manche @_mancheCorrente.Ordine · Stato: <strong>@_mancheCorrente.Stato</strong> · Domande: @_mancheCorrente.Domande.Count</p>
                @if (_domandaCorrente is null)
                {
                    <p class="mb-0">Nessuna domanda aperta.</p>
                }
                else
                {
                    <h3 class="h5">Domanda @_domandaCorrente.Index</h3>
                    <p class="mb-0">@_domandaCorrente.Domanda?.Testo</p>
                }
            }
        </div>
    </section>

    @if (_domandaCorrente?.DtEnd is not null && !_domandaCorrente.IsAnnullata)
    {
        <section class="card border-danger mb-3">
            <div class="card-body">
                <h2 class="h5 text-danger">Operazione straordinaria</h2>
                <p>Annulla la domanda corrente e ricalcola i risultati. Questa operazione è separata dai comandi di avanzamento.</p>
                <div class="d-flex flex-wrap gap-2">
                    <input class="form-control" style="max-width: 28rem" @bind="_motivoAnnullamento" aria-label="Motivo annullamento domanda" />
                    <button class="btn btn-outline-danger" @onclick="AnnullaDomandaAsync" aria-label="Annulla domanda e ricalcola">
                        <span aria-hidden="true">↶</span> Annulla domanda e ricalcola
                    </button>
                </div>
            </div>
        </section>
    }

    @if (!string.IsNullOrWhiteSpace(_messaggio))
    {
        <div class="alert alert-success">@_messaggio</div>
    }
    @if (!string.IsNullOrWhiteSpace(_errore))
    {
        <div class="alert alert-danger">@_errore</div>
    }
}

@code {
    [Parameter] public int PartitaId { get; set; }

    private Partita? _partita;
    private Manche? _mancheCorrente;
    private MancheDomanda? _domandaCorrente;
    private IDisposable? _gameStateSubscription;
    private long _lastStateVersion = -1;

    private bool _isLoading = true;
    private bool _richiedeConfermaAttivazione;
    private string? _partitaAttivaDaSostituire;
    private string? _messaggio;
    private string? _errore;
    private string _motivoAnnullamento = "Errore nella domanda.";

    private bool _haDomandaSuccessiva =>
        _mancheCorrente is not null
        && _domandaCorrente is not null
        && _mancheCorrente.Domande.Any(item => item.Index > _domandaCorrente.Index && !item.IsAnnullata);

    private bool _haMancheSuccessiva =>
        _partita is not null
        && _mancheCorrente is not null
        && MancheOrderingService.GetNext(_partita.Manches, _mancheCorrente.Id) is not null;

    private bool _qrVisibile =>
        GameState.Current.PartitaId != PartitaId || GameState.Current.IsQrVisible;

    protected override void OnInitialized()
    {
        _gameStateSubscription = GameState.Subscribe(OnGameStateChanged);
    }

    protected override async Task OnParametersSetAsync()
    {
        _isLoading = true;
        _messaggio = null;
        _errore = null;
        _richiedeConfermaAttivazione = false;
        _partitaAttivaDaSostituire = null;

        await ReloadFromDbAsync(publish: false);
        if (_partita is not null)
            await PreparaAttivazioneAsync();

        if (!_richiedeConfermaAttivazione)
            await PublishStateAsync();

        _isLoading = false;
    }

    private void OnGameStateChanged(GameState state)
    {
        if (state.PartitaId != PartitaId || state.Version == _lastStateVersion)
            return;

        _lastStateVersion = state.Version;
        _ = InvokeAsync(AggiornaDopoCambioStatoAsync);
    }

    private async Task AggiornaDopoCambioStatoAsync()
    {
        await ReloadFromDbAsync(publish: false);
    }

    private async Task PreparaAttivazioneAsync()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        var result = await PartitaAttivaService.VerificaAttivazioneAsync(db, PartitaId);
        if (!result.IsSuccess)
        {
            _errore = result.Messaggio;
            return;
        }

        if (result.RequiresConfirmation)
        {
            _richiedeConfermaAttivazione = true;
            _partitaAttivaDaSostituire = result.PartitaAttivaTitolo;
            return;
        }

        await AttivaPartitaAsync();
    }

    private async Task ConfermaAttivazioneAsync()
    {
        _errore = null;
        await AttivaPartitaAsync();
    }

    private async Task AttivaPartitaAsync()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        var result = await PartitaAttivaService.ImpostaAttivaAsync(db, PartitaId);
        if (!result.IsSuccess)
        {
            _errore = result.Messaggio;
            return;
        }

        _richiedeConfermaAttivazione = false;
        _partitaAttivaDaSostituire = null;
        _messaggio = result.Changed ? "Partita attiva aggiornata." : null;
        await ReloadFromDbAsync(publish: true);
    }

    private void AggiornaDomandaCorrente()
    {
        _domandaCorrente = null;

        if (_mancheCorrente is null || _partita?.CurrentMancheDomandaId is null)
            return;

        _domandaCorrente = _mancheCorrente.Domande
            .FirstOrDefault(item => item.Id == _partita.CurrentMancheDomandaId.Value);
    }

    private async Task AvviaPartitaAsync()
    {
        await ExecuteTransitionAsync(db => PartitaStateMachineService.AvviaPartitaAsync(db, PartitaId, Clock));
    }

    private async Task AvviaMancheSuccessivaAsync()
    {
        if (_mancheCorrente is null) return;
        await ExecuteTransitionAsync(db => PartitaStateMachineService.AvviaMancheSuccessivaAsync(db, PartitaId, _mancheCorrente.Id, Clock));
    }

    private async Task ProssimaDomandaAsync()
    {
        if (_domandaCorrente is null) return;
        await ExecuteTransitionAsync(db => PartitaStateMachineService.AvviaDomandaSuccessivaAsync(db, PartitaId, _domandaCorrente.Id, Clock));
    }

    private async Task ChiudiDomandaAsync()
    {
        if (_domandaCorrente is null) return;
        await ExecuteTransitionAsync(db => PartitaStateMachineService.ChiudiDomandaAsync(db, PartitaId, _domandaCorrente.Id, Clock));
    }

    private async Task MostraClassificaAsync()
    {
        if (_domandaCorrente is null) return;
        await ExecuteTransitionAsync(db => PartitaStateMachineService.MostraClassificaAsync(db, PartitaId, _domandaCorrente.Id));
    }

    private async Task AnnullaDomandaAsync()
    {
        if (_domandaCorrente is null) return;
        await ExecuteTransitionAsync(db => QuestionCancellationService.AnnullaAsync(
            db,
            PartitaId,
            _domandaCorrente.Id,
            _motivoAnnullamento,
            Clock));
    }

    private async Task ChiudiMancheAsync()
    {
        if (_mancheCorrente is null) return;
        await ExecuteTransitionAsync(db => PartitaStateMachineService.ConcludiMancheAsync(db, PartitaId, _mancheCorrente.Id));
    }

    private async Task ConcludiPartitaAsync()
    {
        await ExecuteTransitionAsync(db => PartitaStateMachineService.ConcludiPartitaAsync(db, PartitaId));
    }

    private async Task CambiaVisibilitaQrAsync()
    {
        _messaggio = null;
        _errore = null;

        if (GameState.Current.PartitaId != PartitaId)
            await PublishStateAsync();

        var state = GameState.Current;
        if (state.PartitaId != PartitaId)
        {
            _errore = "Non è possibile aggiornare il QR della partita corrente.";
            return;
        }

        GameState.SetQrVisibility(PartitaId, !state.IsQrVisible);
        _messaggio = state.IsQrVisible
            ? "QR nascosto sul proiettore."
            : "QR mostrato sul proiettore.";
    }

    private async Task ExecuteTransitionAsync(Func<ArciQuizDbContext, Task<PartitaTransitionResult>> command)
    {
        _messaggio = null;
        _errore = null;
        try
        {
            await using var db = await DbFactory.CreateDbContextAsync();
            var result = await command(db);
            await ReloadFromDbAsync(publish: true);
            if (result.IsSuccess)
                _messaggio = result.Messaggio;
            else
                _errore = result.Messaggio;
        }
        catch (Exception ex)
        {
            _errore = "Errore nell'aggiornamento della partita: " + ex.Message;
        }
    }

    private async Task ReloadFromDbAsync(bool publish)
    {
        await using var db = await DbFactory.CreateDbContextAsync();

        _partita = await db.Partite
            .AsNoTracking()
            .Include(p => p.Manches)
                .ThenInclude(m => m.Domande)
                    .ThenInclude(md => md.Domanda)
            .FirstOrDefaultAsync(p => p.Id == PartitaId);

        if (_partita is null)
        {
            _mancheCorrente = null;
            _domandaCorrente = null;
            if (publish) await PublishStateAsync();
            return;
        }

        if (_partita.CurrentMancheId.HasValue)
            _mancheCorrente = _partita.Manches.FirstOrDefault(m => m.Id == _partita.CurrentMancheId.Value);
        else
            _mancheCorrente = MancheOrderingService.Order(_partita.Manches).FirstOrDefault();
        AggiornaDomandaCorrente();

        if (publish) await PublishStateAsync();
        await InvokeAsync(StateHasChanged);
    }

    private async Task PublishStateAsync()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        var state = await PartitaStateMachineService.CaricaStatoAsync(db, PartitaId, Clock);
        if (state is not null)
            GameState.SetState(state);
    }

    private static string DescriviFase(GamePhase fase) => fase switch
    {
        GamePhase.Idle => "In attesa di preparazione",
        GamePhase.Waiting => "In attesa della regia",
        GamePhase.Lobby => "Lobby aperta",
        GamePhase.ShowingQuestion => "Domanda aperta",
        GamePhase.ShowingAnswers => "Soluzione mostrata",
        GamePhase.Leaderboard => "Classifica mostrata",
        GamePhase.RoundEnded => "Manche conclusa",
        GamePhase.Closed => "Partita conclusa",
        _ => "Stato non disponibile"
    };

    private static string DescriviStato(PartitaStato stato) => stato switch
    {
        PartitaStato.Nuova => "Nuova",
        PartitaStato.Configurazione => "In configurazione",
        PartitaStato.Pronta => "Pronta",
        PartitaStato.InCorso => "In corso",
        PartitaStato.Conclusa => "Conclusa",
        _ => "Stato non disponibile"
    };

    public void Dispose() => _gameStateSubscription?.Dispose();

    private void TornaAllAdmin() => Nav.NavigateTo("/admin");
}
