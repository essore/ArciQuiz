@page "/regia/{PartitaId:int}"
@attribute [Authorize]

@using Core.Entities
@using Core.Enums
@using Infrasctructure.Data
@using Microsoft.EntityFrameworkCore
@using Web.Services
@inject IDbContextFactory<ArciQuizDbContext> DbFactory
@inject NavigationManager Nav
@inject IGameStateService GameState
@inject TimeProvider Clock
@inject IJSRuntime JS

<PageTitle>Regia partita</PageTitle>

@if (_isLoading)
{
    <p>Caricamento...</p>
}
else if (_partita is null)
{
    <div class="alert alert-danger">
        Partita non trovata.
    </div>
}
else
{
    <h1>Regia della partita:  @_partita.Titolo</h1>

    <div class="mb-3">
        <button class="btn btn-secondary" @onclick="TornaAllAdmin">
            &larr; Torna al pannello admin
        </button>
    </div>


    <div class="row">
        <div class="col-md-4">
            <h2>Info partita</h2>
            <p>
                Stato: @_partita.Stato<br />
                Creata il @_partita.DtCreazione.ToLocalTime():g<br />
                Manches: @_partita.Manches.Count
            </p>

            <div class="mb-3">
                <label class="form-label">Manche</label>

                <select class="form-select"
                        value="@_mancheSelezionataId"
                        @onchange="OnMancheChanged">
                    <option value="">-- Seleziona manche --</option>

                    @foreach (var m in _partita.Manches.OrderBy(m => m.Id))
                    {
                        <option value="@m.Id.ToString()">
                            Manche @m.Ordine (@m.Stato) - Domande: @m.Domande.Count
                        </option>
                    }
                </select>
            </div>

            @if (_mancheCorrente is not null)
            {
                <div class="card">
                    <div class="card-body">
                        <h5 class="card-title">Stato manche @(_mancheCorrente.Ordine)</h5>
                        <p class="card-text">
                            Stato: <strong>@_mancheCorrente.Stato</strong><br />
                            Domande totali: @_mancheCorrente.Domande.Count<br />
                            Domanda corrente: @(_domandaCorrente is null ? "—" : _domandaCorrente.Index.ToString())
                        </p>

                        <div class="d-grid gap-2">
                            <button class="btn btn-primary"
                                    @onclick="StartMancheAsync"
                                    disabled="@(!_puoStartare)">
                                @(_partita.Fase == GamePhase.Lobby ? "Avvia partita" : "Avvia manche successiva")
                            </button>

                            <button class="btn btn-warning"
                                    @onclick="ChiudiDomandaAsync"
                                    disabled="@(_partita.Fase != GamePhase.ShowingQuestion)">
                                Chiudi domanda e mostra soluzione
                            </button>

                            <button class="btn btn-info"
                                    @onclick="MostraClassificaAsync"
                                    disabled="@(_partita.Fase != GamePhase.ShowingAnswers)">
                                Mostra classifica
                            </button>

                            <button class="btn btn-success"
                                    @onclick="ProssimaDomandaAsync"
                                    disabled="@(!_puoPassareProssima)">
                                Prossima domanda
                            </button>

                            <button class="btn btn-secondary"
                                    @onclick="ChiudiMancheAsync"
                                    disabled="@(_partita.Fase != GamePhase.Leaderboard || _haDomandaSuccessiva)">
                                Concludi manche
                            </button>

                            <button class="btn btn-danger"
                                    @onclick="ConcludiPartitaAsync"
                                    disabled="@(_partita.Fase != GamePhase.RoundEnded || _haMancheSuccessiva)">
                                Concludi partita
                            </button>

                            @if (_domandaCorrente?.DtEnd is not null && !_domandaCorrente.IsAnnullata)
                            {
                                <input class="form-control" @bind="_motivoAnnullamento" aria-label="Motivo annullamento domanda" />
                                <button class="btn btn-outline-danger" @onclick="AnnullaDomandaAsync">
                                    Annulla domanda e ricalcola
                                </button>
                            }

                            <button class="btn btn-dark" @onclick="ApriProiettore">
                                Apri proiettore
                            </button>
                        </div>
                    </div>
                </div>
            }
            else
            {
                <p>Seleziona una manche per iniziare la regia.</p>
            }

            @if (!string.IsNullOrWhiteSpace(_messaggio))
            {
                <div class="alert alert-success mt-3">@_messaggio</div>
            }
            @if (!string.IsNullOrWhiteSpace(_errore))
            {
                <div class="alert alert-danger mt-3">@_errore</div>
            }
        </div>

        <div class="col-md-8">
            <h2>Domande della manche</h2>

            @if (_mancheCorrente is null)
            {
                <p>Seleziona una manche per vedere le domande.</p>
            }
            else if (!_mancheCorrente.Domande.Any())
            {
                <p>Nessuna domanda associata a questa manche.</p>
            }
            else
            {
                <p> ci sono @_mancheCorrente.Domande.Count() domande nella manche</p>
                @* <table class="table table-sm align-middle">
                    <thead>
                        <tr>
                            <th>#</th>
                            <th>Stato</th>
                            <th>Domanda</th>
                            <th>Categoria</th>
                            <th>Difficoltà</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var md in _mancheCorrente.Domande.OrderBy(md => md.Index))
                        {
                            var isCorrente = _domandaCorrente is not null && md.Id == _domandaCorrente.Id;
                            <tr class="@(isCorrente ? "table-info" : string.Empty)">
                                <td>@md.Index</td>
                                <td>@GetStatoDomanda(md)</td>
                                <td>
                                    <strong>@md.Domanda?.Testo</strong><br />
                                    A: @md.Domanda?.RispostaA<br />
                                    B: @md.Domanda?.RispostaB<br />
                                    C: @md.Domanda?.RispostaC<br />
                                    D: @md.Domanda?.RispostaD
                                </td>
                                <td>@md.Domanda?.Categoria</td>
                                <td>@md.Domanda?.Difficolta</td>
                            </tr>
                        }
                    </tbody>
                </table> *@
            }

            @if (_domandaCorrente is not null)
            {
                <hr />
                <h2>Domanda corrente</h2>
                <div class="card">
                    <div class="card-body">
                        <h4>@_domandaCorrente.Domanda?.Testo</h4>
                        <p>
                            A) @_domandaCorrente.Domanda?.RispostaA<br />
                            B) @_domandaCorrente.Domanda?.RispostaB<br />
                            C) @_domandaCorrente.Domanda?.RispostaC<br />
                            D) @_domandaCorrente.Domanda?.RispostaD
                        </p>
                        <p class="text-muted">
                            (Per ora risposta corretta solo visibile qui: @_domandaCorrente.Domanda?.RispostaEsatta)
                        </p>
                    </div>
                </div>
            }
        </div>
    </div>
}

@code {
    [Parameter] public int PartitaId { get; set; }

    private Partita? _partita;
    private Manche? _mancheCorrente;
    private MancheDomanda? _domandaCorrente;

    private bool _isLoading = true;
    private string? _mancheSelezionataId;

    private string? _messaggio;
    private string? _errore;
    private string _motivoAnnullamento = "Errore nella domanda.";

    private bool _puoStartare =>
        _partita?.Fase == GamePhase.Lobby
        || (_partita?.Fase == GamePhase.RoundEnded && _haMancheSuccessiva);

    private bool _puoPassareProssima =>
        (_partita?.Fase is GamePhase.ShowingAnswers or GamePhase.Leaderboard)
        && _domandaCorrente is not null
        && _haDomandaSuccessiva;

    private bool _haDomandaSuccessiva =>
        _mancheCorrente is not null
        && _domandaCorrente is not null
        && _mancheCorrente.Domande.Any(item => item.Index > _domandaCorrente.Index && !item.IsAnnullata);

    private bool _haMancheSuccessiva =>
        _partita is not null
        && _mancheCorrente is not null
        && _partita.Manches.Any(item => item.Ordine > _mancheCorrente.Ordine);

    protected override async Task OnParametersSetAsync()
    {
        _isLoading = true;
        _messaggio = null;
        _errore = null;

        await ReloadFromDbAsync(publish: false);

        // Pubblica lo stato iniziale (quando apro la regia)
        await PublishStateAsync();

        _isLoading = false;
    }
    private async Task OnMancheChanged(ChangeEventArgs e)
    {
        _messaggio = null;
        _errore = null;

        _mancheSelezionataId = e.Value?.ToString();

        if (_partita is null || string.IsNullOrWhiteSpace(_mancheSelezionataId))
        {
            _mancheCorrente = null;
            _domandaCorrente = null;

            return;
        }

        if (!int.TryParse(_mancheSelezionataId, out var mid))
        {
            _mancheCorrente = null;
            _domandaCorrente = null;

            return;
        }

        _mancheCorrente = _partita.Manches.FirstOrDefault(m => m.Id == mid);
        AggiornaDomandaCorrente();

        await InvokeAsync(StateHasChanged);
    }

    private void AggiornaDomandaCorrente()
    {
        _domandaCorrente = null;

        if (_mancheCorrente is null)
            return;

        if (_partita?.CurrentMancheDomandaId is not null)
        {
            _domandaCorrente = _mancheCorrente.Domande
                .FirstOrDefault(item => item.Id == _partita.CurrentMancheDomandaId.Value);
        }
    }

    private async Task StartMancheAsync()
    {
        if (_partita?.Fase == GamePhase.Lobby)
            await ExecuteTransitionAsync(db => PartitaStateMachineService.AvviaPartitaAsync(db, PartitaId, Clock));
        else if (_partita?.Fase == GamePhase.RoundEnded && _mancheCorrente is not null)
            await ExecuteTransitionAsync(db => PartitaStateMachineService.AvviaMancheSuccessivaAsync(db, PartitaId, _mancheCorrente.Id, Clock));
    }

    private async Task ProssimaDomandaAsync()
    {
        if (_domandaCorrente is null) return;
        await ExecuteTransitionAsync(db => PartitaStateMachineService.AvviaDomandaSuccessivaAsync(db, PartitaId, _domandaCorrente.Id, Clock));
    }

    private async Task ChiudiDomandaAsync()
    {
        if (_domandaCorrente is null) return;
        await ExecuteTransitionAsync(db => PartitaStateMachineService.ChiudiDomandaAsync(db, PartitaId, _domandaCorrente.Id, Clock));
    }

    private async Task MostraClassificaAsync()
    {
        if (_domandaCorrente is null) return;
        await ExecuteTransitionAsync(db => PartitaStateMachineService.MostraClassificaAsync(db, PartitaId, _domandaCorrente.Id));
    }

    private async Task AnnullaDomandaAsync()
    {
        if (_domandaCorrente is null) return;
        await ExecuteTransitionAsync(db => QuestionCancellationService.AnnullaAsync(
            db,
            PartitaId,
            _domandaCorrente.Id,
            _motivoAnnullamento,
            Clock));
    }

    private async Task ChiudiMancheAsync()
    {
        if (_mancheCorrente is null) return;
        await ExecuteTransitionAsync(db => PartitaStateMachineService.ConcludiMancheAsync(db, PartitaId, _mancheCorrente.Id));
    }

    private async Task ConcludiPartitaAsync()
    {
        await ExecuteTransitionAsync(db => PartitaStateMachineService.ConcludiPartitaAsync(db, PartitaId));
    }

    private async Task ExecuteTransitionAsync(Func<ArciQuizDbContext, Task<PartitaTransitionResult>> command)
    {
        _messaggio = null;
        _errore = null;
        try
        {
            await using var db = await DbFactory.CreateDbContextAsync();
            var result = await command(db);
            await ReloadFromDbAsync(publish: true);
            if (result.IsSuccess)
                _messaggio = result.Messaggio;
            else
                _errore = result.Messaggio;
        }
        catch (Exception ex)
        {
            _errore = "Errore nell'aggiornamento della partita: " + ex.Message;
        }
    }

    private async Task ReloadFromDbAsync(bool publish)
    {
        await using var db = await DbFactory.CreateDbContextAsync();

        _partita = await db.Partite
            .AsNoTracking()
            .Include(p => p.Manches)
                .ThenInclude(m => m.Domande)
                    .ThenInclude(md => md.Domanda)
            .FirstOrDefaultAsync(p => p.Id == PartitaId);

        if (_partita is null)
        {
            _mancheCorrente = null;
            _domandaCorrente = null;
            if (publish) await PublishStateAsync();
            return;
        }

        if (_partita.CurrentMancheId.HasValue)
            _mancheCorrente = _partita.Manches.FirstOrDefault(m => m.Id == _partita.CurrentMancheId.Value);
        else if (!string.IsNullOrWhiteSpace(_mancheSelezionataId) && int.TryParse(_mancheSelezionataId, out var mid))
            _mancheCorrente = _partita.Manches.FirstOrDefault(m => m.Id == mid);
        else
            _mancheCorrente = _partita.Manches.OrderBy(m => m.Id).FirstOrDefault();

        _mancheSelezionataId = _mancheCorrente?.Id.ToString();
        AggiornaDomandaCorrente();

        if (publish) await PublishStateAsync();
        await InvokeAsync(StateHasChanged);
    }

    private async Task PublishStateAsync()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        var state = await PartitaStateMachineService.CaricaStatoAsync(db, PartitaId, Clock);
        if (state is not null)
            GameState.SetState(state);
    }

    private static string GetStatoDomanda(MancheDomanda md)
    {
        if (md.DtStart == null && md.DtEnd == null) return "In attesa";
        if (md.DtStart != null && md.DtEnd == null) return "In corso";
        if (md.DtStart != null && md.DtEnd != null) return "Conclusa";
        return "Sconosciuto";
    }

    private void TornaAllAdmin() => Nav.NavigateTo("/admin");
    //private void ApriProiettore() => Nav.NavigateTo($"/proiettore/{PartitaId}");
    private async Task ApriProiettore()
    {
        var url = $"/proiettore/{PartitaId}";
        await JS.InvokeVoidAsync("openInNewTab", url);
    }
}
