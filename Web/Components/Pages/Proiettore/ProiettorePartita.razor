@page "/proiettore/{PartitaId:int}"

@using Core.Entities
@using Core.Enums
@using Infrasctructure.Data
@using Microsoft.EntityFrameworkCore
@inject ArciQuizDbContext Db

<PageTitle>Proiettore</PageTitle>

@if (_isLoading)
{
    <div class="d-flex justify-content-center align-items-center" style="height:80vh;">
        <h2>Caricamento...</h2>
    </div>
}
else if (_partita is null)
{
    <div class="d-flex justify-content-center align-items-center" style="height:80vh;">
        <h2>Partita non trovata.</h2>
    </div>
}
else
{
    <div class="container-fluid" style="padding:2rem;">

        <div class="mb-4 d-flex justify-content-between">
            <div>
                <h1 style="font-size:3rem;">@_partita.Titolo</h1>
                <p style="font-size:1.4rem;">
                    Manche: @(_mancheCorrente?.Id.ToString() ?? "—") ·
                    Stato manche: @(_mancheCorrente?.Stato.ToString() ?? "Nessuna manche attiva")
                </p>
            </div>
            <div class="text-end">
                <p style="font-size:1.2rem;">
                    Stato partita: @_partita.Stato
                </p>
            </div>
        </div>

        @if (_mancheCorrente is null || !_mancheCorrente.Domande.Any())
        {
            <div class="d-flex justify-content-center align-items-center" style="height:60vh;">
                <h2 style="font-size:3rem;">In attesa di una manche...</h2>
            </div>
        }
        else if (_domandaCorrente is null)
        {
            <div class="d-flex justify-content-center align-items-center" style="height:60vh;">
                @if (_mancheCorrente.Stato == MancheStato.Conclusa)
                {
                    <h2 style="font-size:3rem;">Manche conclusa</h2>
                }
                else
                {
                    <h2 style="font-size:3rem;">In attesa della prossima domanda...</h2>
                }
            </div>
        }
        else
        {
            <div class="mb-4">
                <h2 style="font-size:2.5rem;">
                    Domanda @_domandaCorrente.Index
                </h2>
                <h3 style="font-size:2rem; margin-top:1rem;">
                    @_domandaCorrente.Domanda?.Testo
                </h3>
                <p class="text-muted" style="font-size:1.2rem; margin-top:0.5rem;">
                    Categoria: @_domandaCorrente.Domanda?.Categoria ·
                    Difficoltà: @_domandaCorrente.Domanda?.Difficolta
                </p>
            </div>

            <div class="row" style="font-size:1.8rem;">
                <div class="col-md-6 mb-3">
                    <div class="border rounded p-3">
                        <strong>A)</strong> @_domandaCorrente.Domanda?.RispostaA
                    </div>
                </div>
                <div class="col-md-6 mb-3">
                    <div class="border rounded p-3">
                        <strong>B)</strong> @_domandaCorrente.Domanda?.RispostaB
                    </div>
                </div>
                <div class="col-md-6 mb-3">
                    <div class="border rounded p-3">
                        <strong>C)</strong> @_domandaCorrente.Domanda?.RispostaC
                    </div>
                </div>
                <div class="col-md-6 mb-3">
                    <div class="border rounded p-3">
                        <strong>D)</strong> @_domandaCorrente.Domanda?.RispostaD
                    </div>
                </div>
            </div>

            <div class="mt-4 text-muted" style="font-size:1.2rem;">
                <!-- Qui in futuro potrai mostrare countdown / numero risposte / ecc. -->
                In attesa delle risposte dei giocatori...
            </div>
        }
    </div>
}

@code {
    [Parameter] public int PartitaId { get; set; }

    private Partita? _partita;
    private Manche? _mancheCorrente;
    private MancheDomanda? _domandaCorrente;

    private bool _isLoading = true;

    private System.Threading.PeriodicTimer? _timer;
    private CancellationTokenSource? _cts;

    protected override async Task OnInitializedAsync()
    {
        _cts = new CancellationTokenSource();
        await CaricaStato();

        // refresh automatico ogni 1 secondo
        _timer = new System.Threading.PeriodicTimer(TimeSpan.FromSeconds(1));
        _ = AggiornaLoop(_cts.Token);
    }

    private async Task AggiornaLoop(CancellationToken token)
    {
        try
        {
            while (!token.IsCancellationRequested && _timer != null && await _timer.WaitForNextTickAsync(token))
            {
                await CaricaStato();
                await InvokeAsync(StateHasChanged);
            }
        }
        catch (OperationCanceledException)
        {
            // normale in chiusura
        }
    }

    private async Task CaricaStato()
    {
        _isLoading = true;

        _partita = await Db.Partite
            .Include(p => p.Manches)
                .ThenInclude(m => m.Domande)
                    .ThenInclude(md => md.Domanda)
            .FirstOrDefaultAsync(p => p.Id == PartitaId);

        if (_partita != null)
        {
            // manche in corso se presente, sennò la prima non conclusa, altrimenti null
            _mancheCorrente =
                _partita.Manches.FirstOrDefault(m => m.Stato == MancheStato.InGioco)
                ?? _partita.Manches.FirstOrDefault(m => m.Stato != MancheStato.Conclusa);

            if (_mancheCorrente != null)
            {
                _domandaCorrente = _mancheCorrente.Domande
                    .OrderBy(md => md.Index)
                    .FirstOrDefault(md => md.DtStart != null && md.DtEnd == null);
            }
            else
            {
                _domandaCorrente = null;
            }
        }
        else
        {
            _mancheCorrente = null;
            _domandaCorrente = null;
        }

        _isLoading = false;
    }

    public async ValueTask DisposeAsync()
    {
        _cts?.Cancel();
        _cts?.Dispose();
        if (_timer != null)
        {
            _timer.Dispose();
        }

        await Task.CompletedTask;
    }
}
