@page "/proiettore/{PartitaId:int}"
@layout MinimalLayout
@implements IDisposable

@using Core.Entities
@using Core.Enums
@using Infrasctructure.Data
@using Microsoft.EntityFrameworkCore
@using Web.Services

@inject IGameStateService GameState
@inject IDbContextFactory<ArciQuizDbContext> DbFactory
@inject TimeProvider Clock

<PageTitle>Proiettore</PageTitle>

@if (_isLoading)
{
    <div class="d-flex justify-content-center align-items-center" style="height:80vh;">
        <h2>Caricamento...</h2>
    </div>
}
else if (_view is null)
{
    <div class="d-flex justify-content-center align-items-center" style="height:80vh  ;">
        <h2>In attesa della regia...</h2>
    </div>
}
else
{
    <main class="projector-shell">
        <header class="projector-header">
            <div class="text-end">
                @if (_view.MostraQr && _view.Domanda is not null)
                {
                    <LanQr Title="Rientra nel gioco"
                           RelativePath="/gioca"
                           MaxWidthPx="120"
                           ShowLink="false"
                           CssClass="d-inline-block" />
                }
            </div>
        </header>

        @if (_view.Classifica is not null)
        {
            <section class="leaderboard-shell">
                <h2 class="leaderboard-title">@_view.TitoloClassifica</h2>
                @if (_view.MostraPodio)
                {
                    <div class="row text-center mb-5" aria-label="Podio">
                        @foreach (var entry in _view.Classifica.Entries.Where(item => item.Position <= 3))
                        {
                            <div class="col-md-4 mb-3">
                                <div class="border rounded p-3">
                                    <strong style="font-size:2rem;">@entry.Position<span>°</span></strong>
                                    <div style="font-size:1.8rem;">@entry.TeamName</div>
                                    <div>@entry.Points punti</div>
                                </div>
                            </div>
                        }
                    </div>
                }
                <table class="table table-striped table-lg" style="font-size:1.6rem;">
                    <thead><tr><th>Pos.</th><th>Squadra</th><th class="text-end">Punti</th></tr></thead>
                    <tbody>
                        @foreach (var entry in _view.Classifica.Entries)
                        {
                            <tr><td>@entry.Position<span>°</span></td><td>@entry.TeamName</td><td class="text-end">@entry.Points</td></tr>
                        }
                    </tbody>
                </table>
            </section>
        }
        else if (_view.Domanda is null)
        {
            <div class="projector-placeholder">
                <h2>@_view.PlaceholderText</h2>

                @if (_view.MostraQr)
                {
                    <LanQr Title="Scansiona per partecipare"
                           RelativePath="/gioca"
                           MaxWidthPx="320"
                           ShowLink="false"
                           CssClass="mt-0" />
                }
            </div>
        }
        else
        {
            <section>
                <h2 class="question-title">
                    Domanda @_view.Domanda.Index
                </h2>
                <h3 class="question-text">
                    @_view.Domanda.Testo
                </h3>
                <p class="question-meta">
                    Categoria: @_view.Domanda.Categoria · Difficoltà: @_view.Domanda.Difficolta
                </p>
            </section>

            @if (_view.PhaseEndsAtUtc.HasValue)
            {
                <div class="question-countdown"><ProjectorCountdown EndsAtUtc="_view.PhaseEndsAtUtc.Value" DurationSeconds="_view.DurationSeconds" IsTimedOut="_view.MostraSoluzione" /></div>
            }

            <div class="answer-grid" aria-label="Opzioni di risposta">
                <div class="answer-card answer-a @AnswerResultClass('A')">
                    <span class="answer-letter">A</span><span class="answer-content"><span>@_view.Domanda.RispostaA</span>@AnswerResultIcon('A')</span>
                </div>
                <div class="answer-card answer-b @AnswerResultClass('B')">
                    <span class="answer-letter">B</span><span class="answer-content"><span>@_view.Domanda.RispostaB</span>@AnswerResultIcon('B')</span>
                </div>
                <div class="answer-card answer-c @AnswerResultClass('C')">
                    <span class="answer-letter">C</span><span class="answer-content"><span>@_view.Domanda.RispostaC</span>@AnswerResultIcon('C')</span>
                </div>
                <div class="answer-card answer-d @AnswerResultClass('D')">
                    <span class="answer-letter">D</span><span class="answer-content"><span>@_view.Domanda.RispostaD</span>@AnswerResultIcon('D')</span>
                </div>
            </div>

            @if (_view.MostraSoluzione)
            {
                <section aria-label="Risultati della domanda">
                    <div class="results-grid">
                        <div class="result-card correct"><span>Risposte corrette</span><strong>@_view.RisultatiDomanda!.CorrectAnswers</strong></div>
                        <div class="result-card incorrect"><span>Risposte errate</span><strong>@_view.RisultatiDomanda.IncorrectAnswers</strong></div>
                        <div class="result-card abstained"><span>Astensioni</span><strong>@_view.RisultatiDomanda.Abstentions</strong></div>
                    </div>
                    <div class="fastest-answer">
                        @if (_view.RisultatiDomanda.FastestAnswer is null)
                        {
                            <span>Risposta valida più veloce</span><strong>Nessuna risposta valida</strong>
                        }
                        else if (_view.RisultatiDomanda.FastestAnswer.IsTie)
                        {
                            <span>Risposte valide più veloci, a pari tempo</span><strong>@string.Join(" e ", _view.RisultatiDomanda.FastestAnswer.TeamNames) — @FormatElapsedTime(_view.RisultatiDomanda.FastestAnswer.ElapsedMilliseconds)</strong>
                        }
                        else
                        {
                            <span>Risposta valida più veloce</span><strong>@_view.RisultatiDomanda.FastestAnswer.TeamNames[0] — @FormatElapsedTime(_view.RisultatiDomanda.FastestAnswer.ElapsedMilliseconds)</strong>
                        }
                    </div>
                </section>
            }
            else if (!_view.PhaseEndsAtUtc.HasValue)
            {
                <div class="question-status">In attesa delle risposte dei giocatori...</div>
            }
        }
    </main>
}

@code {
    [Parameter] public int PartitaId { get; set; }

    private bool _isLoading = true;
    private IDisposable? _sub;

    private ProjectorViewModel? _view;

    // Dedup: evita ricarichi doppi se arriva lo stesso stato
    private long _lastVersion = -1;

    protected override async Task OnInitializedAsync()
    {
        _sub = GameState.Subscribe(state =>
        {
            // Filtra: questa pagina ascolta solo la sua partita
            if (state.PartitaId != PartitaId) return;

            // Dedup su version
            if (state.Version == _lastVersion) return;
            _lastVersion = state.Version;

            _ = InvokeAsync(async () =>
            {
                await LoadFromStateAsync(state);
                _isLoading = false;
                StateHasChanged();
            });
        });

        var state = GameState.Current.PartitaId == PartitaId
            ? GameState.Current
            : await LoadPersistedStateAsync();
        if (state is not null)
        {
            await LoadFromStateAsync(state);
            _lastVersion = state.Version;
        }

        _isLoading = false;
    }

    private async Task LoadFromStateAsync(GameState state)
    {
        await using var db = await DbFactory.CreateDbContextAsync();

        if (state.Phase is GamePhase.Leaderboard or GamePhase.RoundEnded or GamePhase.Closed)
        {
            var partitaClassifica = await db.Partite
                .AsNoTracking()
                .Include(item => item.Manches)
                .FirstOrDefaultAsync(item => item.Id == state.PartitaId);
            if (partitaClassifica is null)
            {
                _view = null;
                return;
            }

            var mancheClassifica = state.MancheId.HasValue
                ? partitaClassifica.Manches.FirstOrDefault(item => item.Id == state.MancheId.Value)
                : null;
            _view = new ProjectorViewModel
            {
                PartitaTitolo = partitaClassifica.Titolo,
                TitoloClassifica = state.Phase switch
                {
                    GamePhase.RoundEnded => $"Classifica dopo la manche {mancheClassifica?.Ordine}",
                    GamePhase.Closed => "Classifica finale",
                    _ => "Classifica parziale"
                },
                MostraPodio = state.Phase == GamePhase.Closed,
                MostraQr = state.IsQrVisible,
                Classifica = await LeaderboardService.LoadAsync(db, state.PartitaId)
            };
            return;
        }

        // Stato minimo ma coerente: se la regia non ha ancora impostato manche/domanda, placeholder
        if (state.MancheId is null || state.MancheDomandaId is null)
        {
            _view = new ProjectorViewModel
            {
                MostraQr = state.IsQrVisible,
                PlaceholderText = state.Phase switch
                {
                    GamePhase.Waiting => "In attesa della regia...",
                    GamePhase.Idle => "In attesa della regia...",
                    GamePhase.Closed => "Partita chiusa",
                    _ => "In attesa..."
                }
            };
            return;
        }

        // Carico solo quello che serve per render: titolo partita, manche, domanda corrente
        var partita = await db.Partite
            .AsNoTracking()
            .Include(p => p.Manches)
                .ThenInclude(m => m.Domande)
                    .ThenInclude(md => md.Domanda)
            .FirstOrDefaultAsync(p => p.Id == state.PartitaId);

        if (partita is null)
        {
            _view = null;
            return;
        }

        var manche = partita.Manches.FirstOrDefault(m => m.Id == state.MancheId.Value);
        var md = manche?.Domande.FirstOrDefault(x => x.Id == state.MancheDomandaId.Value);

        if (manche is null || md?.Domanda is null)
        {
            _view = new ProjectorViewModel
            {
                PartitaTitolo = partita.Titolo,
                MostraQr = state.IsQrVisible,
                PlaceholderText = "In attesa della prossima domanda..."
            };
            return;
        }

        _view = new ProjectorViewModel
        {
            PartitaTitolo = partita.Titolo,
            MostraQr = state.IsQrVisible,
            MostraSoluzione = state.Phase == GamePhase.ShowingAnswers,
            PhaseEndsAtUtc = state.PhaseEndsAtUtc ?? md.ScadenzaUtc,
            DurationSeconds = md.DurataSecondiOverride ?? manche.TempoRispostaSecondi,
            RisultatiDomanda = state.Phase == GamePhase.ShowingAnswers
                ? await ProjectorQuestionResultsService.LoadAsync(db, md.Id)
                : null,
            Domanda = new DomandaVm
            {
                Index = md.Index,
                Testo = md.Domanda.Testo ?? "",
                Categoria = md.Domanda.Categoria ?? "",
                Difficolta = md.Domanda.Difficolta ?? "",
                RispostaA = md.Domanda.RispostaA ?? "",
                RispostaB = md.Domanda.RispostaB ?? "",
                RispostaC = md.Domanda.RispostaC ?? "",
                RispostaD = md.Domanda.RispostaD ?? "",
                RispostaEsatta = md.Domanda.RispostaEsatta
            }
        };
    }

    private async Task<GameState?> LoadPersistedStateAsync()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        return await PartitaStateMachineService.CaricaStatoAsync(db, PartitaId, Clock);
    }

    public void Dispose() => _sub?.Dispose();

    private sealed class ProjectorViewModel
    {
        public string PartitaTitolo { get; set; } = "ArciQuiz";
        public string PlaceholderText { get; set; } = "In attesa...";
        public bool MostraSoluzione { get; set; }
        public bool MostraQr { get; set; } = true;
        public bool MostraPodio { get; set; }
        public DateTimeOffset? PhaseEndsAtUtc { get; set; }
        public int DurationSeconds { get; set; }
        public ProjectorQuestionResults? RisultatiDomanda { get; set; }
        public string TitoloClassifica { get; set; } = "Classifica";
        public LeaderboardView? Classifica { get; set; }

        public DomandaVm? Domanda { get; set; }
    }

    private sealed class DomandaVm
    {
        public int Index { get; set; }
        public string Testo { get; set; } = "";
        public string Categoria { get; set; } = "";
        public string Difficolta { get; set; } = "";
        public string RispostaA { get; set; } = "";
        public string RispostaB { get; set; } = "";
        public string RispostaC { get; set; } = "";
        public string RispostaD { get; set; } = "";
        public char RispostaEsatta { get; set; }
    }

    private bool IsCorrectAnswer(char answer) =>
        _view?.MostraSoluzione == true && _view.Domanda?.RispostaEsatta == answer;

    private string AnswerResultClass(char answer)
    {
        if (!_view?.MostraSoluzione ?? true)
            return string.Empty;

        return IsCorrectAnswer(answer) ? "is-correct" : "is-incorrect";
    }

    private RenderFragment AnswerResultIcon(char answer) => builder =>
    {
        if (_view?.MostraSoluzione != true)
            return;

        var isCorrect = IsCorrectAnswer(answer);
        builder.OpenElement(0, "span");
        builder.AddAttribute(1, "class", isCorrect ? "answer-result-icon correct" : "answer-result-icon incorrect");
        builder.AddAttribute(2, "aria-label", isCorrect ? "Risposta corretta" : "Risposta errata");
        builder.AddContent(3, isCorrect ? "✓" : "✕");
        builder.CloseElement();
    };

    private static string FormatElapsedTime(int milliseconds) =>
        TimeSpan.FromMilliseconds(milliseconds).TotalSeconds.ToString("0.0") + " s";
}
