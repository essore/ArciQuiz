@using Web.Services
@inject ILanUrlService LanUrl
@inject IQrCodeService Qr

@if (!string.IsNullOrWhiteSpace(_url) && !string.IsNullOrWhiteSpace(_qrDataUrl))
{
    <div class="card @CssClass">
        <div class="card-body">
            <h5 class="card-title">@Title</h5>

            <img src="@_qrDataUrl" style="max-width:@MaxWidthPx; width:100%;" />

            @if (ShowLink)
            {
                <div class="mt-2">
                    <small class="text-muted">Link:</small><br />
                    <a href="@_url" target="_blank">@_url</a>
                </div>
            }
        </div>
    </div>
}
else
{
    <div class="alert alert-warning @CssClass">
        Non riesco a determinare l'IP LAN. Controlla rete/Wi-Fi.
    </div>
}

@code {
    [Parameter, EditorRequired] public string RelativePath { get; set; } = default!; // es: "/proiettore/2"
    [Parameter] public string Title { get; set; } = "QR";
    [Parameter] public bool ShowLink { get; set; } = true;

    [Parameter] public int MaxWidthPx { get; set; } = 240;
    [Parameter] public int PixelsPerModule { get; set; } = 8;

    [Parameter] public string CssClass { get; set; } = "mt-3";

    private string? _url;
    private string? _qrDataUrl;

    protected override void OnParametersSet()
    {
        Build();
    }

    private void Build()
    {
        _url = LanUrl.BuildUrl(RelativePath);
        if (string.IsNullOrWhiteSpace(_url))
        {
            _qrDataUrl = null;
            return;
        }

        _qrDataUrl = Qr.ToDataUrlPng(_url, pixelsPerModule: PixelsPerModule);
    }
}
